# LankaPulse — Real-Time Breaking News Map of Sri Lanka

## Environment Configuration
# Copy this to .env and fill in your values

# --- LLM Provider (pick one) ---
# Google Gemini (Free Tier)
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Groq (Free Tier)
# GROQ_API_KEY=
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile

# OpenAI-compatible local (llama.cpp)
# LLM_PROVIDER=local
# LLM_BASE_URL=http://localhost:8080/v1
# LLM_MODEL=local-model

# --- Ingestion Settings ---
POLL_INTERVAL_SECONDS=180
MAX_CONCURRENT_SCRAPERS=4
HEADLESS_BROWSER_TIMEOUT=15000

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./lankapulse.db

# --- Server ---
HOST=0.0.0.0
PORT=8000
