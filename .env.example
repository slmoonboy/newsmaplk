# LankaPulse — configuration template
#
# Copy to .env and edit as needed:
#     cp .env.example .env
#
# Every default works without an API key or paid account.

# ─── Server ─────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# Comma-separated origins; * is fine for a local demo.
CORS_ORIGINS=*

# ─── Database ───────────────────────────────────────────────
# Defaults to <project>/data/lankapulse.db when left empty.
# DATABASE_URL=sqlite+aiosqlite:///./data/lankapulse.db

# ─── Ingestion pipeline ─────────────────────────────────────
# Set to false to serve only seeded/demo data (no background network calls).
ENABLE_PIPELINE=true
POLL_INTERVAL_SECONDS=180
MAX_ITEMS_PER_CYCLE=6
ITEM_PAUSE_SECONDS=1.5
RAW_ITEM_RETENTION_DAYS=7

# ─── Local language model (open weights, no key) ─────────────
# auto | ollama | openai_compatible | heuristic
#
#   auto               probe LLM_BASE_URL; fall back to rules if unavailable
#   ollama             local Ollama server (default)
#   openai_compatible  llama.cpp, vLLM, LM Studio, etc.
#   heuristic          skip the model and use the built-in rule extractor
#
# To use Ollama:
#   ollama pull qwen2.5:7b-instruct
#   ollama serve
LLM_PROVIDER=auto
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=ollama
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=1400
MIN_CONFIDENCE=0.35
HEURISTIC_FALLBACK=true

# ─── Free corroboration providers ───────────────────────────
# Google News RSS + Wikipedia are enabled by default.
ENABLE_GROUNDING=true
GROUNDING_MAX_SOURCES=5
GROUNDING_TIMEOUT_SECONDS=12
GROUNDING_CACHE_SECONDS=600
ENABLE_ARTICLE_FETCH=true

# GDELT DOC 2.0 is open data but is aggressively rate-limited; keep this off
# unless you accept slow cycles and temporary 429 blocks.
ENABLE_GDELT=false

# ─── Optional YouTube channel RSS (public feed, no API key) ──
# Comma-separated channel IDs, e.g. UCxxxxxxxx,UCyyyyyyyy
YOUTUBE_CHANNEL_IDS=

# ─── Admin ──────────────────────────────────────────────────
# If set, POST /api/trigger-cycle requires the x-admin-token header.
ADMIN_TOKEN=
